# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/frontend/node_modules
/backend/node_modules

# testing
/coverage

# next.js
/.next/
/out/
/frontend/.next/
/backend/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime uploads and generated review reports
/backend/src/data/uploads/
/backend/src/data/.legacy-dist-imported
/frontend/eslint-review.json
